# =====================================================================
# Daily News Briefing & Podcast Configuration
# =====================================================================

# 1. Google Gemini API Key (Required for LLM summarization and Gemini TTS)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Email Delivery Configuration (SMTP)
# For Gmail: Use your full email and a 16-character App Password (not your personal password).
# Generate an App Password at: https://myaccount.google.com/apppasswords
SENDER_EMAIL=your_email@gmail.com
SENDER_APP_PASSWORD=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Target recipient(s), comma-separated if multiple
RECIPIENT_EMAIL=recipient@example.com

# 3. Timezone & Scheduling
# Default is Mountain Time (America/Edmonton) for 7:00 AM daily delivery
TIMEZONE=America/Edmonton
SCHEDULE_TIME=07:00

# 4. Audio & Podcast Preferences
# TTS Engine: 'gemini' (preferred) or 'gtts' (local/testing fallback)
TTS_ENGINE=gemini
# Gemini Voice name: Kore, Puck, Fenrir, Aoede, Charon, etc.
VOICE_NAME=Kore
# Target word count for ~10 minute spoken conversational script (1300-1500 words at 140-150 wpm)
TARGET_PODCAST_WORDS=1400

# 5. Directories
OUTPUT_DIR=output
